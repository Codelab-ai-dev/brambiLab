# Local development values only. Production secrets are set in Coolify, never committed.
POSTGRES_DB=brambilab
POSTGRES_USER=brambilab
# Single quotes keep the value literal. Reserved characters are supported (no URL is built);
# avoid "$", which Compose treats as interpolation.
POSTGRES_PASSWORD='change-me@local/#1'

# Host ports bound to 127.0.0.1 by compose.yaml.
WEB_HOST_PORT=3000
API_HOST_PORT=8080

# Planned for later tasks (web-v1.md §14); not read by WEB-001 yet:
# PUBLIC_ORIGIN=
# ADMIN_GITHUB_USER_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
