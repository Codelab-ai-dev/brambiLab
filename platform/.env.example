# Local development values only. Production secrets are set in Coolify, never committed.
POSTGRES_DB=brambilab
POSTGRES_USER=brambilab
# Single quotes keep the value literal. Reserved characters are supported (no URL is built);
# avoid "$", which Compose treats as interpolation.
POSTGRES_PASSWORD='change-me@local/#1'

# Public entry (proxy) bound to 127.0.0.1. PUBLIC_ORIGIN must match what the browser uses.
PUBLIC_HOST_PORT=8000
PUBLIC_ORIGIN=http://localhost:8000

# Owner login (WEB-002). Leave empty to keep login disabled. Put real values only in .env.
# OAuth App callback: ${PUBLIC_ORIGIN}/api/v1/auth/github/callback
ADMIN_GITHUB_USER_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Contact form (WEB-007, web-v1.md §13.1). Disabled unless CONTACT_ENABLED=true AND the three
# values below are valid. Real values only in .env (local) or Coolify secrets; never commit them.
# See docs/operations/contacto-resend.md before enabling.
CONTACT_ENABLED=false
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. BrambiLab <contacto@your-domain>
CONTACT_FROM=
# Fixed recipient (independent of the public e-mail shown on the site)
CONTACT_TO=
# Optional tuning: CONTACT_RATE_PER_CLIENT=5 CONTACT_RATE_GLOBAL=100 CONTACT_RETENTION_DAYS=30

# Off-site backup (WEB-008, docs/operations/backup.md). Idle unless BACKUP_REMOTE and
# BACKUP_PASSPHRASE are set. The destination is an rclone remote named "dest".
BACKUP_REMOTE=
BACKUP_PASSPHRASE=
# RCLONE_CONFIG_DEST_TYPE=s3
# RCLONE_CONFIG_DEST_PROVIDER=
# RCLONE_CONFIG_DEST_ENDPOINT=
# RCLONE_CONFIG_DEST_ACCESS_KEY_ID=
# RCLONE_CONFIG_DEST_SECRET_ACCESS_KEY=

# Planned for later tasks (web-v1.md §14):
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=/data/media
# EDITORIAL_TZ=America/Mexico_City
