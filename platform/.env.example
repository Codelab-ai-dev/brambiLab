# Local development values only. Production secrets are set in Coolify, never committed.
POSTGRES_DB=brambilab
POSTGRES_USER=brambilab
# Single quotes keep the value literal. Reserved characters are supported (no URL is built);
# avoid "$", which Compose treats as interpolation.
POSTGRES_PASSWORD='change-me@local/#1'

# Public entry (proxy) bound to 127.0.0.1. PUBLIC_ORIGIN must match what the browser uses.
PUBLIC_HOST_PORT=8000
PUBLIC_ORIGIN=http://localhost:8000

# Owner login (WEB-002). Leave empty to keep login disabled. Put real values only in .env.
# OAuth App callback: ${PUBLIC_ORIGIN}/api/v1/auth/github/callback
ADMIN_GITHUB_USER_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Planned for later tasks (web-v1.md §14):
# RESEND_API_KEY=
# CONTACT_FROM=
# CONTACT_TO=
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=/data/media
