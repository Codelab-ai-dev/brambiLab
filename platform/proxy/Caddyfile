# Single public entry point (web-v1.md §3). One origin for web and API, so cookies, OAuth
# callback and CSRF checks behave the same locally and on the VPS. TLS is terminated in front
# of this proxy (Coolify's proxy in production); here it listens on plain HTTP.
{
	admin off
	auto_https off
}

:8000 {
	# Private panel: never cacheable nor indexable, whatever the route, status or data request (#12).
	@admin path /admin /admin/*
	header @admin {
		Cache-Control "no-store, private"
		X-Robots-Tag "noindex, nofollow"
		defer
	}

	# Uploads are streamed to Go, which enforces per-type limits (web-v1.md §12.1).
	@upload path /api/v1/admin/assets
	request_body @upload {
		max_size 256MB
	}

	@api path /api/v1/* /media/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
